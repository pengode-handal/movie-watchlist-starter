{
    "name": "filmlog-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "FilmLog API",
    "engines": {
        "node": ">=22.9.0"
    },
    "scripts": {
        "dev": "node --watch src/server.js",
        "start": "node src/server.js",
        "db:push": "dotenv --no-expand -- npm run db:push:cli",
        "db:push:cli": "supabase db push --remote=\"$DATABASE_URL\" --skip-vault"
    },
    "dependencies": {
        "@google/genai": "^2.32.0",
        "bcrypt": "^6.0.0",
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.3",
        "jsonwebtoken": "^9.0.3",
        "pg": "8.23.1"
    },
    "devDependencies": {
        "dotenv-cli": "^11.1.0",
        "supabase": "3.0.0"
    },
    "allowScripts": {
        "node-gyp-build@4.8.4": true,
        "bcrypt@6.0.0": true,
        "@google/genai@2.32.0": true,
        "protobufjs@7.6.6": true
    }
}
