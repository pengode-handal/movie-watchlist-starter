{
  "name": "filmlog-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FilmLog API",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/db.js migrate",
    "db:status": "node --env-file-if-exists=.env scripts/db.js status",
    "db:migration:new": "supabase migration new",
    "db:seed": "node --env-file-if-exists=.env scripts/db.js seed"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "supabase": "3.0.0"
  },
  "allowScripts": {
    "node-gyp-build@4.8.4": true,
    "bcrypt@6.0.0": true,
    "@google/genai@2.32.0": true,
    "protobufjs@7.6.6": true
  }
}
