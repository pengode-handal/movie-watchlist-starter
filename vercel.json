{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "regions": ["sin1"],
    "services": {
        "frontend": { "root": "frontend" },
        "backend": { "root": "backend", "entrypoint": "src/server.js" }
    },
    "rewrites": [
        { "source": "/api/(.*)", "destination": { "service": "backend" } },
        { "source": "/(.*)", "destination": { "service": "frontend" } }
    ]
}
